# Copy to .env.local and adjust for your environment.

# web-api-gateway REST base URL (reactive Spring service).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# This app's own public origin - used to build absolute metadata URLs and
# OAuth redirect_uri values. Must match whatever port `next dev` runs on.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth client IDs are public (the client secret never leaves the gateway/
# auth-service - the frontend only ever sends an authorization `code`).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
